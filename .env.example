# ==============================================================================
# FinWise Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure all secrets before deploying:
#   cp .env.example .env
#
# IMPORTANT: NEVER commit the actual .env file or credentials to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Boot & Application Profiles
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
PORT=8080
APP_NAME=FinWise

# ------------------------------------------------------------------------------
# 2. Database Configuration (Aiven MySQL / Cloud Hosted / Local MySQL)
# ------------------------------------------------------------------------------
# For Aiven MySQL:
#   DB_HOST = Service URI host (e.g., mysql-xxxx-yourorg.aivencloud.com)
#   DB_PORT = Service port (e.g., 25060)
#   DB_NAME = Database name (default in Aiven is 'defaultdb' or custom 'finwise_db')
#   DB_USERNAME = Database user (default in Aiven is 'avnadmin')
#   DB_PASSWORD = Aiven database password
#   DB_SSL_MODE = REQUIRED (mandated by Aiven for encrypted TLS connection)
DB_HOST=mysql-replace-with-aiven-hostname.aivencloud.com
DB_PORT=25060
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=replace_with_your_aiven_database_password
DB_SSL_MODE=REQUIRED

# Optional: If you prefer to supply the full Aiven JDBC URI directly:
# DB_JDBC_URL=jdbc:mysql://mysql-replace-with-aiven-hostname.aivencloud.com:25060/defaultdb?sslMode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

# MySQL Root Password (used only if running local Docker container)
MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password_32chars!

# Connection Pool Tuning (HikariCP)
DB_POOL_MAX=20
DB_POOL_MIN=5

# ------------------------------------------------------------------------------
# 3. Security & JWT Cryptography
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 256/384/512-bit HMAC key (minimum 64 hex characters):
# Example generator: openssl rand -hex 64
JWT_SECRET=replace_with_strong_random_hex_jwt_secret_min_64_characters_entropy_required
JWT_ACCESS_EXPIRATION_MS=900000        # 15 minutes in milliseconds
JWT_REFRESH_EXPIRATION_MS=604800000    # 7 days in milliseconds
JWT_ISSUER=FinWiseApp

# ------------------------------------------------------------------------------
# 4. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes)
# In production, specify your exact domain(s)
CORS_ALLOWED_ORIGINS=https://finwise.yourdomain.com,https://app.yourdomain.com

# ------------------------------------------------------------------------------
# 5. Background Task Scheduler
# ------------------------------------------------------------------------------
SCHEDULER_ENABLED=true
RECURRING_CRON=0 0 2 * * ?             # Runs daily at 02:00 AM UTC

# ------------------------------------------------------------------------------
# 6. Logging & Monitoring
# ------------------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_FINWISE=INFO
LOG_FILE_PATH=/var/log/finwise/application.log

# ------------------------------------------------------------------------------
# 7. Frontend Client Environment
# ------------------------------------------------------------------------------
# When deployed behind Nginx reverse proxy, leave empty or set to /api/v1
VITE_API_URL=/api/v1
